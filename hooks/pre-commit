#!/bin/bash

# Pre-commit hook to prevent committing sensitive data (keys, secrets, credentials).
# Adapted from the same hook in options_modeling (itself from rainfall_bot).
# Tracked in-repo (hooks/) rather than .git/hooks/ so it survives a fresh clone
# -- see README for the one-time `git config core.hooksPath hooks` setup step.
#
# Project-specific additions over the options_modeling version:
#   * EIA_KEY patterns (inherited from the source hook; this project's provider
#     is MarketParquet, whose key is caught by the literal scan below)
#   * a literal scan for the real key values held in ~/.<service>/api_key.txt,
#     which catches a paste of THIS project's key that no generic regex would
#   * the test block runs tests/ with pytest (skipped only if tests/ is absent)

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running security checks..."

# HIGH-RISK PATTERNS - Will BLOCK commit
BLOCK_PATTERNS=(
    # Generic API key/secret/token assignments
    "api[_-]?key.*['\"][a-zA-Z0-9_\-]{20,}['\"]"
    "api[_-]?secret.*['\"][^'\"]{16,}['\"]"
    "secret[_-]?key.*['\"][^'\"]{16,}['\"]"
    "access[_-]?token.*['\"][a-zA-Z0-9_\-\.]{16,}['\"]"
    "['\"]password['\"]:\s*['\"][^'\"]+['\"]"

    # EIA API key (kept from the source hook).  EIA keys are 40 alphanumeric
    # chars -- mixed case, so the [a-f0-9]{40} commit-hash warn pattern misses them.
    "EIA[_-]?KEY\s*[=:]\s*['\"]?[A-Za-z0-9]{20,}"
    "api\.eia\.gov[^[:space:]]*api_key=[A-Za-z0-9]{20,}"

    # Common vendor key formats
    "sk-[a-zA-Z0-9]{20,}"          # OpenAI-style secret keys
    "AKIA[0-9A-Z]{16}"             # AWS Access Key ID
    "ghp_[a-zA-Z0-9]{36}"          # GitHub personal access token
    "xox[baprs]-[a-zA-Z0-9-]{10,}" # Slack tokens

    # SSH/PGP/crypto private key material
    "BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY"
    "private[_-]?key.*['\"]?[a-fA-F0-9]{64}"
    "0x[a-fA-F0-9]{64}"
)

# MEDIUM-RISK PATTERNS - Will WARN (not block)
WARN_PATTERNS=(
    "[a-f0-9]{40}"                          # 40 hex chars (commit hash, or a key)
    "api[_-]?key"                           # any mention of an api key, unquoted forms included
)

found_sensitive=0
found_warnings=0

staged_files=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$staged_files" ]; then
    echo "No files staged"
    exit 0
fi

for file in $staged_files; do
    if file "$file" 2>/dev/null | grep -q "text"; then
        for pattern in "${BLOCK_PATTERNS[@]}"; do
            if grep -iE "$pattern" "$file" > /dev/null 2>&1; then
                echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
                echo -e "${RED}CRITICAL: possible secret/key detected in $file${NC}"
                echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
                echo -e "${RED}Pattern matched: $pattern${NC}"
                grep -inE "$pattern" "$file" | head -2
                echo ""
                found_sensitive=1
            fi
        done

        for pattern in "${WARN_PATTERNS[@]}"; do
            if grep -iE "$pattern" "$file" > /dev/null 2>&1; then
                echo -e "${YELLOW}WARNING: possible sensitive data in $file (pattern: $pattern)${NC}"
                found_warnings=1
            fi
        done
    fi
done

# Block dangerous file types/names outright.
# NOTE: these are REGEXES, not shell globs.  The options_modeling/rainfall_bot
# version of this hook listed globs ("*.key", "*api_key*") and passed them to
# grep -E, where a leading "*" is an invalid expression.  grep exited 2 on every
# one of them and `2>/dev/null` swallowed it, so the whole section silently
# blocked nothing except ".env" (which matched only because "." is any-char).
# Verified 2026-09-11.  Fix that hook too.  stderr is deliberately NOT muted here.
BLOCKED_NAME_PATTERNS=(
    "\.key$"
    "\.pem$"
    "\.keystore$"
    "\.jks$"
    "\.p12$"
    "credentials.*\.json$"
    "secret.*\.json$"
    "api[_-]?key"
    "(^|/)\.env$"
    "(^|/)\.env\."
    "(^|/)\.netrc$"
    "id_(rsa|dsa|ecdsa|ed25519)$"
)

for pattern in "${BLOCKED_NAME_PATTERNS[@]}"; do
    matches=$(echo "$staged_files" | grep -iE "$pattern")
    if [ -n "$matches" ]; then
        echo -e "${RED}BLOCKED: dangerous filename staged (pattern: $pattern)${NC}"
        echo "$matches"
        found_sensitive=1
    fi
done

if [ $found_sensitive -eq 1 ]; then
    echo ""
    echo -e "${RED}COMMIT BLOCKED: possible secret/key/credential detected.${NC}"
    echo -e "${RED}If this is a false positive, fix the pattern in hooks/pre-commit rather than${NC}"
    echo -e "${RED}bypassing with --no-verify.${NC}"
    exit 1
fi

# --- Literal key scan ------------------------------------------------------
# Regexes catch key-SHAPED strings. This catches the actual secrets sitting in
# ~/.<service>/api_key.txt, including ones no pattern here anticipates. The keys
# are read at hook runtime and never written into the repo.
for keyfile in "$HOME"/.*/api_key.txt; do
    [ -f "$keyfile" ] || continue
    secret=$(tr -d '[:space:]' < "$keyfile")
    [ ${#secret} -ge 12 ] || continue
    for file in $staged_files; do
        if grep -qF -- "$secret" "$file" 2>/dev/null; then
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}CRITICAL: $file contains the live key from $keyfile${NC}"
            echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
            echo -e "${RED}Line(s): $(grep -nF -- "$secret" "$file" | cut -d: -f1 | tr '\n' ' ')${NC}"
            echo -e "${RED}(value not printed).  Rotate that key if it has ever been pushed.${NC}"
            found_sensitive=1
        fi
    done
done

if [ $found_sensitive -eq 1 ]; then
    echo ""
    echo -e "${RED}COMMIT BLOCKED: a live key was found in the staged content.${NC}"
    exit 1
fi

if [ $found_warnings -eq 1 ]; then
    echo ""
    echo -e "${YELLOW}Warnings found, but commit allowed. Double-check the files above.${NC}"
fi

echo "Security check passed - safe to commit"
# --- Test suite ------------------------------------------------------------
# The working agreement says tests pass before committing. On 2026-09-11 a
# commit went in with test_readme_consistency failing -- during the write-up of
# a result that reversed that morning's headline, i.e. the moment of highest
# cognitive load in the session. A convention you remember to check is not a
# control; it fails exactly when it is most needed. So it is a hook.
#
# Skip deliberately with SKIP_TESTS=1 git commit (recorded, not silent).
if [ -z "$SKIP_TESTS" ] && compgen -G "tests/test_*.py" >/dev/null 2>&1; then
    echo "Running test suite..."
    if ! python3 -m pytest -q >/tmp/pre_commit_pytest.log 2>&1; then
        echo -e "${RED}TESTS FAILED - commit blocked.${NC}"
        tail -20 /tmp/pre_commit_pytest.log
        echo -e "${YELLOW}Fix them, or SKIP_TESTS=1 git commit to override.${NC}"
        exit 1
    fi
    echo "Tests passed."
fi

exit 0
